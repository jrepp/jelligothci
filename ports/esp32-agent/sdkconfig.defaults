CONFIG_IDF_TARGET="esp32s3"
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
CONFIG_FREERTOS_HZ=1000
# The BSP compiles its LVGL glue even though the agent draws to the panel directly.
CONFIG_LV_COLOR_DEPTH_16=y

# Audio, networking, and a large character need the faster clock (RFC-003).
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_COMPILER_OPTIMIZATION_PERF=y

# Wi-Fi keeps its configuration in RAM and calibrates the radio at each start: the
# default nvs partition holds the pet's save and the agent never opens it. Agent
# settings, Wi-Fi credentials included, live in agent_nvs (settings.c). wifi.c
# refuses to build if either option is on.
CONFIG_ESP_WIFI_NVS_ENABLED=n
CONFIG_ESP_PHY_CALIBRATION_AND_DATA_STORAGE=n
# Wi-Fi and lwIP buffers in PSRAM where they may be, saving internal RAM.
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y

# The pet's flash layout A (ADR-013); this project never flashes its own bootloader
# or table, but its image must agree with them.
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="../esp32/partitions.csv"
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y
