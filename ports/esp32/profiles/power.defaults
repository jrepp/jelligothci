# Explicit power experiments only; runtime automatic sleep remains opt-in.
CONFIG_PM_ENABLE=y
CONFIG_PM_PROFILING=y
CONFIG_PM_DFS_INIT_AUTO=n
CONFIG_FREERTOS_USE_TICKLESS_IDLE=y
CONFIG_USJ_NO_AUTO_LS_ON_CONNECTION=y
# Retain CPU state: this board image has no free retention-capable heap.
CONFIG_PM_POWER_DOWN_CPU_IN_LIGHT_SLEEP=n
CONFIG_JELLI_POWER_EXPERIMENTS=y
