# Experimental power image only; compare with cache/baseline.defaults.
CONFIG_ESP32S3_INSTRUCTION_CACHE_16KB=y
CONFIG_ESP32S3_INSTRUCTION_CACHE_32KB=n
CONFIG_ESP32S3_DATA_CACHE_16KB=n
CONFIG_ESP32S3_DATA_CACHE_32KB=n
CONFIG_ESP32S3_DATA_CACHE_64KB=y
CONFIG_ESP32S3_DATA_CACHE_LINE_16B=n
CONFIG_ESP32S3_DATA_CACHE_LINE_32B=y
CONFIG_ESP32S3_DATA_CACHE_LINE_64B=n
CONFIG_JELLI_MEMORY_TRIAL=0
