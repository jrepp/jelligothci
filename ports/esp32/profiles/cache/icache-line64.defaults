# Combine the independently promising changes without enlarging the data cache.
CONFIG_ESP32S3_INSTRUCTION_CACHE_16KB=n
CONFIG_ESP32S3_INSTRUCTION_CACHE_32KB=y
CONFIG_ESP32S3_DATA_CACHE_16KB=n
CONFIG_ESP32S3_DATA_CACHE_32KB=y
CONFIG_ESP32S3_DATA_CACHE_64KB=n
CONFIG_ESP32S3_DATA_CACHE_LINE_16B=n
CONFIG_ESP32S3_DATA_CACHE_LINE_32B=n
CONFIG_ESP32S3_DATA_CACHE_LINE_64B=y
CONFIG_JELLI_MEMORY_TRIAL=0
