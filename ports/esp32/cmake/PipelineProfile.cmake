# Validation-only instrumentation of the pinned adapter. Never edit managed sources.
function(jelli_pipeline_profile)
    idf_component_get_property(adapter_lib espressif__esp_lvgl_adapter COMPONENT_LIB)
    idf_component_get_property(adapter_dir espressif__esp_lvgl_adapter COMPONENT_DIR)
    set(original "${adapter_dir}/src/display/bridge/v9/lvgl_bridge_v9.c")
    set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${original}")
    file(SHA256 "${original}" digest)
    if(NOT digest STREQUAL "424e7ef240aee67da6a42f9f065bcdc1114393ab7ea38e4f7e449edfcb33f2ed")
        message(FATAL_ERROR "Pipeline profile requires reviewed adapter 0.6.4 source")
    endif()
    file(READ "${original}" contents)
    set(before "    compact_stride_to_packed(color_map, area, disp, bridge_color_bytes(impl));")
    # Instrument both partial flush paths; this board uses the default path, not TE.
    string(REPLACE "${before}" "${before}\n    uint64_t jelli_swap_start = jelli_profile_now();" contents "${contents}")
    set(before "        lv_draw_sw_rgb565_swap(color_map, lv_area_get_size(area));\n    }")
    string(REPLACE "${before}" "${before}\n    jelli_profile_swap(jelli_swap_start);" contents "${contents}")
    set(before "static bool IRAM_ATTR display_bridge_v9_on_io_color_trans_done(esp_lcd_panel_io_handle_t panel_io,\n                                                               esp_lcd_panel_io_event_data_t *edata,\n                                                               void *user_ctx)\n{")
    string(FIND "${contents}" "${before}" position)
    if(position LESS 0)
        message(FATAL_ERROR "Pipeline completion anchor missing")
    endif()
    string(REPLACE "${before}" "${before}\n    jelli_profile_color_done();" contents "${contents}")
    set(contents "#include <stdint.h>\nextern uint64_t jelli_profile_now(void);\nextern void jelli_profile_swap(uint64_t);\nextern void jelli_profile_color_done(void);\n${contents}")
    set(generated "${CMAKE_BINARY_DIR}/jelli-generated/lvgl_pipeline_profile.c")
    file(MAKE_DIRECTORY "${CMAKE_BINARY_DIR}/jelli-generated")
    file(CONFIGURE OUTPUT "${generated}" CONTENT "${contents}" @ONLY)
    get_target_property(sources ${adapter_lib} SOURCES)
    set(replaced)
    foreach(source IN LISTS sources)
        if(source MATCHES "(^|/)lvgl_bridge_v9[.]c$")
            list(APPEND replaced "${generated}")
        else()
            list(APPEND replaced "${source}")
        endif()
    endforeach()
    target_include_directories(${adapter_lib} PRIVATE "${adapter_dir}/src/display/bridge/v9")
    set_property(TARGET ${adapter_lib} PROPERTY SOURCES "${replaced}")
endfunction()
