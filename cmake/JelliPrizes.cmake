# Explicit append-only prize slots decouple save identity from artwork ID order.
function(jelli_prizes_data output)
  get_filename_component(root "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/.." ABSOLUTE)
  set(source "${root}/content/prizes.json")
  set(assets_source "${root}/assets/slice/assets.json")
  set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${source}" "${assets_source}")
  file(READ "${source}" data)
  file(READ "${assets_source}" assets)
  string(JSON version GET "${data}" version)
  string(JSON version_type TYPE "${data}" version)
  string(JSON count LENGTH "${data}" prizes)
  set(legacy butterfly pearl-tooth breakfast-sun tea-sprite movie-star bubble-gem moon-charm rainbow-seed friendship-bow teddy-bear jelli-chain-cartridge morning-tea-record garden-waltz-record porch-picnic-record tiny-thunder-record neon-heart-record cloud-club-record pixel-sunset-record)
  list(LENGTH legacy required_count)
  if(NOT version_type STREQUAL "NUMBER" OR NOT version EQUAL 1 OR count LESS required_count OR count GREATER 20)
    message(FATAL_ERROR "Prize registry needs version 1 and ${required_count}..20 append-only slots")
  endif()
  string(JSON asset_count LENGTH "${assets}" assets)
  math(EXPR last_asset "${asset_count} - 1")
  foreach(a RANGE 0 ${last_asset})
    string(JSON candidate GET "${assets}" assets ${a} id)
    set(prize_asset_index_${candidate} ${a})
  endforeach()
  math(EXPR last "${count} - 1")
  set(keys "")
  set(asset_ids "")
  set(rows "")
  foreach(i RANGE 0 ${last})
    foreach(field id key name asset)
      string(JSON ${field} GET "${data}" prizes ${i} ${field})
    endforeach()
    string(JSON id_type TYPE "${data}" prizes ${i} id)
    string(JSON asset_type TYPE "${data}" prizes ${i} asset)
    string(LENGTH "${name}" name_length)
    if(NOT id_type STREQUAL "NUMBER" OR NOT asset_type STREQUAL "NUMBER" OR NOT id MATCHES "^[0-9]+$" OR NOT id EQUAL i OR
       NOT key MATCHES "^[a-z0-9]+(-[a-z0-9]+)*$" OR key IN_LIST keys OR
       NOT name MATCHES "^[A-Z0-9 ]+$" OR name_length GREATER 24 OR
       NOT asset MATCHES "^[0-9]+$" OR asset LESS 1 OR asset GREATER 65535 OR asset IN_LIST asset_ids)
      message(FATAL_ERROR "Invalid prize slot ${i}: unique key/artwork, positional ID and display name required")
    endif()
    if(i LESS required_count)
      list(GET legacy ${i} legacy_key)
      math(EXPR legacy_asset "11001 + ${i}")
      if(NOT key STREQUAL legacy_key OR NOT asset EQUAL legacy_asset)
        message(FATAL_ERROR "Existing prize identities cannot be removed or reordered")
      endif()
    endif()
    if(NOT DEFINED prize_asset_index_${asset})
      message(FATAL_ERROR "Prize ${key} references missing artwork ${asset}")
    endif()
    set(a "${prize_asset_index_${asset}}")
    string(JSON candidate_type TYPE "${assets}" assets ${a} id)
    if(NOT candidate_type STREQUAL "NUMBER")
      message(FATAL_ERROR "Prize artwork IDs must be JSON integer numbers")
    endif()
    string(JSON kind GET "${assets}" assets ${a} kind)
    string(JSON asset_key GET "${assets}" assets ${a} key)
    string(JSON width GET "${assets}" assets ${a} width)
    string(JSON height GET "${assets}" assets ${a} height)
    if(NOT kind STREQUAL "prizes" OR NOT asset_key STREQUAL "prizes.${key}" OR
       NOT width EQUAL 32 OR NOT height EQUAL 32)
      message(FATAL_ERROR "Prize ${key} needs matching prizes.* artwork of 32x32")
    endif()
    list(APPEND keys "${key}")
    list(APPEND asset_ids "${asset}")
    string(APPEND rows "    {\"${key}\", \"${name}\", ${asset}u},\n")
  endforeach()
  set(path "${CMAKE_CURRENT_BINARY_DIR}/generated/jelli_prizes_data.c")
  file(WRITE "${path}" "#include \"jelli/prizes.h\"\nconst JelliPrizeDefinition jelli_prizes[] = {\n${rows}};\nconst unsigned jelli_prize_count = ${count}u;\n")
  set(${output} "${path}" PARENT_SCOPE)
endfunction()
