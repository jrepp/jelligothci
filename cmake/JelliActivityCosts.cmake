function(jelli_activity_pet_costs data valid_forms out)
  string(JSON count LENGTH "${data}" pet_costs)
  list(LENGTH valid_forms form_count)
  if(NOT count EQUAL form_count)
    message(FATAL_ERROR "Every pet form needs one activity cost profile")
  endif()
  math(EXPR last "${count} - 1")
  set(seen "")
  set(rows "")
  foreach(i RANGE 0 ${last})
    string(JSON form GET "${data}" pet_costs ${i} form)
    if(NOT form IN_LIST valid_forms OR form IN_LIST seen)
      message(FATAL_ERROR "Activity cost profiles need unique known forms")
    endif()
    list(APPEND seen "${form}")
    foreach(meter energy hydration)
      string(JSON ${meter} GET "${data}" pet_costs ${i} ${meter}_pct)
      if(NOT ${meter} MATCHES "^[0-9]+$" OR ${meter} GREATER 300)
        message(FATAL_ERROR "Pet ${meter} cost multiplier must be 0..300 percent")
      endif()
    endforeach()
    string(APPEND rows "    {${form}u, ${energy}u, ${hydration}u},\n")
  endforeach()
  set(${out} "const JelliActivityPetCosts jelli_activity_pet_costs[] = {\n${rows}};\nconst unsigned jelli_activity_pet_cost_count = ${count}u;\n" PARENT_SCOPE)
endfunction()

function(jelli_activity_assets root out)
  set(source "${root}/assets/slice/assets.json")
  set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${source}")
  file(READ "${source}" data)
  string(JSON count LENGTH "${data}" assets)
  math(EXPR last "${count} - 1")
  set(ids "")
  foreach(i RANGE 0 ${last})
    string(JSON id GET "${data}" assets ${i} id)
    if(NOT id MATCHES "^[0-9]+$" OR id IN_LIST ids)
      message(FATAL_ERROR "Asset IDs must be unique nonnegative integers")
    endif()
    list(APPEND ids "${id}")
  endforeach()
  set(${out} "${ids}" PARENT_SCOPE)
endfunction()

# Pose names in creature pose-table order (base poses, then state poses), and prize names
# ("prizes.<name>" keys) with their one-based collection slots, for moment "pose"/"prize".
function(jelli_activity_vocab root poses_out prize_names_out prize_slots_out)
  file(READ "${root}/assets/slice/assets.json" data)
  set(poses "")
  foreach(list_name creature_poses state_poses)
    string(JSON n LENGTH "${data}" ${list_name})
    math(EXPR last "${n} - 1")
    foreach(i RANGE 0 ${last})
      if(list_name STREQUAL "creature_poses")
        string(JSON pose GET "${data}" ${list_name} ${i})
      else()
        string(JSON pose GET "${data}" ${list_name} ${i} name)
      endif()
      list(APPEND poses "${pose}")
    endforeach()
  endforeach()
  string(JSON count LENGTH "${data}" assets)
  math(EXPR last "${count} - 1")
  set(names "")
  set(ids "")
  set(first 0)
  foreach(i RANGE 0 ${last})
    string(JSON kind GET "${data}" assets ${i} kind)
    if(kind STREQUAL "prizes")
      string(JSON key GET "${data}" assets ${i} key)
      string(JSON id GET "${data}" assets ${i} id)
      string(REPLACE "prizes." "" name "${key}")
      list(APPEND names "${name}")
      list(APPEND ids "${id}")
      if(first EQUAL 0 OR id LESS first)
        set(first ${id})
      endif()
    endif()
  endforeach()
  set(slots "")
  foreach(id IN LISTS ids)
    math(EXPR slot "${id} - ${first} + 1")
    list(APPEND slots "${slot}")
  endforeach()
  set(${poses_out} "${poses}" PARENT_SCOPE)
  set(${prize_names_out} "${names}" PARENT_SCOPE)
  set(${prize_slots_out} "${slots}" PARENT_SCOPE)
endfunction()

# Optional moment "pose" (a creature pose name) and "prize" (a prize name): pose index + 1 and
# collection slot, or 0 for none.
function(jelli_activity_extras data i name pose_out prize_out)
  set(pose_value 0)
  string(JSON pose ERROR_VARIABLE missing GET "${data}" moments ${i} pose)
  if(NOT missing)
    list(FIND activity_poses "${pose}" index)
    if(index LESS 0)
      message(FATAL_ERROR "Invalid moment ${name}: unknown pose ${pose}")
    endif()
    math(EXPR pose_value "${index} + 1")
  endif()
  set(prize_value 0)
  string(JSON prize ERROR_VARIABLE missing GET "${data}" moments ${i} prize)
  if(NOT missing)
    list(FIND activity_prize_names "${prize}" index)
    if(index LESS 0)
      message(FATAL_ERROR "Invalid moment ${name}: unknown prize ${prize}")
    endif()
    list(GET activity_prize_slots ${index} prize_value)
  endif()
  set(${pose_out} ${pose_value} PARENT_SCOPE)
  set(${prize_out} ${prize_value} PARENT_SCOPE)
endfunction()
