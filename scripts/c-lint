#!/usr/bin/env bash
set -euo pipefail
repo_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
# shellcheck source-path=SCRIPTDIR
# shellcheck source=../toolchain.env
source "$repo_dir/toolchain.env"
cd "$repo_dir"
mode="${1:-check}"
if [[ $# -gt 0 ]]; then shift; fi
format() {
    local flag="$1"
    shift
    local files=()
    if [[ $# -gt 0 ]]; then
        files=("$@")
    else
        while IFS= read -r -d '' file; do files+=("$file"); done < <(
            git ls-files -z -- '*.c' '*.h'
        )
    fi
    if [[ ${#files[@]} -eq 0 ]]; then return; fi
    if [[ "$flag" == check ]]; then
        "$repo_dir/scripts/uvx" --from "clang-format==$JELLI_CLANG_FORMAT_VERSION" \
            clang-format --dry-run --Werror "${files[@]}"
    else
        "$repo_dir/scripts/uvx" --from "clang-format==$JELLI_CLANG_FORMAT_VERSION" \
            clang-format -i "${files[@]}"
    fi
}
analyze() {
    local extra=()
    # The wheel's Clang needs the macOS SDK location to find libc headers.
    if [[ "$(uname -s)" == Darwin ]]; then
        extra=(-isysroot "$(xcrun --show-sdk-path)")
    fi
    "$repo_dir/scripts/uvx" --from "clang-tidy==$JELLI_CLANG_TIDY_VERSION" \
        clang-tidy core/engine.c core/render.c core/animation.c tests/test_engine.c tests/test_animation.c tests/test_render.c \
        -- -std=c11 -Iinclude "${extra[@]}"
}
cppcheck_all() {
    local files=()
    while IFS= read -r -d '' file; do files+=("$file"); done < <(
        git ls-files -z -- '*.c'
    )
    "$repo_dir/scripts/uvx" --from "cppcheck==$JELLI_CPPCHECK_VERSION" cppcheck \
        --enable=warning,style,performance,portability --error-exitcode=1 \
        --std=c11 --inline-suppr -Iinclude "${files[@]}"
}
size_check() {
    "$repo_dir/scripts/uv" run --no-project --with "lizard==$JELLI_LIZARD_VERSION" \
        python "$repo_dir/scripts/check-c-size.py"
}
case "$mode" in
    format-check) format check "$@" ;;
    format) format fix "$@" ;;
    analyze) analyze ;;
    cppcheck) cppcheck_all ;;
    size) size_check ;;
    self-test)
        "$repo_dir/scripts/uv" run --no-project --with "lizard==$JELLI_LIZARD_VERSION" \
            python -m unittest discover -s tests -p test_c_size.py
        ;;
    check) format check; analyze; cppcheck_all; size_check ;;
    *) echo 'Usage: scripts/c-lint [check|format-check|format|analyze|cppcheck|size|self-test] [format-files...]' >&2; exit 2 ;;
esac
