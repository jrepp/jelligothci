#!/usr/bin/env bash
set -euo pipefail
root_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$root_dir"
python3 scripts/check-workflow-pins.py
python3 - <<'CHECK'
import json
import re
from pathlib import Path
version = Path("VERSION").read_text().strip()
if not re.fullmatch(r"(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)", version):
    raise SystemExit("VERSION must be a stable MAJOR.MINOR.PATCH version")
manifest = json.loads(Path(".release-please-manifest.json").read_text())
if manifest.get(".") != version:
    raise SystemExit("VERSION and Release Please manifest differ")
package = json.loads(Path("release-please-config.json").read_text())["packages"]["."]
if package.get("version-file") != "VERSION" or package.get("release-type") != "simple":
    raise SystemExit("expected simple release strategy with VERSION")
for name in ("CHANGELOG.md", ".github/workflows/release.yml", ".github/workflows/release-please.yml"):
    if not Path(name).is_file():
        raise SystemExit(f"missing release file: {name}")
print(f"release metadata valid: {version}")
CHECK
if [[ "${1:-}" == "--metadata-only" ]]; then
  exit 0
fi
if [[ $# -ne 0 ]]; then
  echo "usage: scripts/release-validate [--metadata-only]" >&2
  exit 2
fi
cmake -S . -B build/release-check -DJELLI_BUILD_SDL=OFF -DBUILD_TESTING=ON -DCMAKE_BUILD_TYPE=Release
cmake --build build/release-check --config Release --parallel 2
ctest --test-dir build/release-check --build-config Release --output-on-failure --no-tests=error
python3 tests/test_build_version.py
