{
  "version": 3,
  "configurePresets": [
    {"name": "desktop", "generator": "Ninja", "binaryDir": "${sourceDir}/build/desktop", "cacheVariables": {"CMAKE_BUILD_TYPE": "Debug"}},
    {"name": "sanitize", "inherits": "desktop", "binaryDir": "${sourceDir}/build/sanitize", "cacheVariables": {"JELLI_SANITIZE": "ON"}},
    {"name": "core", "inherits": "desktop", "binaryDir": "${sourceDir}/build/core", "cacheVariables": {"JELLI_BUILD_SDL": "OFF"}}
  ],
  "buildPresets": [{"name": "desktop", "configurePreset": "desktop"}, {"name": "sanitize", "configurePreset": "sanitize"}, {"name": "core", "configurePreset": "core"}],
  "testPresets": [
    {"name": "desktop", "configurePreset": "desktop", "output": {"outputOnFailure": true}},
    {"name": "sanitize", "configurePreset": "sanitize", "output": {"outputOnFailure": true}},
    {"name": "core", "configurePreset": "core", "output": {"outputOnFailure": true}}
  ]
}
