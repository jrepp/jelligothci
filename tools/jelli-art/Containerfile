# Jelli Art. Build from the repository root:
#   podman build -f tools/jelli-art/Containerfile -t jelli-art .
# The image holds the studio code; the art lives in a git checkout on the
# /work volume (cloned on first start). See tools/jelli-art/README.md.
# python:3.15.1-slim-bookworm, multi-arch index digest
FROM docker.io/library/python:3.15.1-slim-bookworm@sha256:9fa5b7003807c47fd10837c5b8b6713e9057de5f9be0d4179f6dae0c55acdf2d

ARG STUDIO_VERSION=0.0.0
ARG SOURCE_REVISION=unknown
LABEL org.opencontainers.image.title="Jelli Art" \
      org.opencontainers.image.description="Browser pixel editor and before/after review for Jelligotchi artwork" \
      org.opencontainers.image.source="https://github.com/jrepp/jelligothci" \
      org.opencontainers.image.version="${STUDIO_VERSION}" \
      org.opencontainers.image.revision="${SOURCE_REVISION}"

# cmake runs the checkout's cmake/JelliBehaviors.cmake to validate behaviour edits;
# gcc, libc headers and make let "Test in game" build and run the real engine.
RUN apt-get update \
    && apt-get install -y --no-install-recommends git openssh-client cmake gcc libc6-dev make \
    && rm -rf /var/lib/apt/lists/* \
    && pip install --no-cache-dir Pillow==13.0.0 \
    && useradd --uid 10001 --create-home --home-dir /home/studio studio \
    && mkdir -p /work && chown studio:studio /work

COPY tools/assets/compare.html tools/assets/compare_slice.py tools/assets/lint_rules.py tools/assets/scene_data.py tools/assets/effect_data.py /app/tools/assets/
COPY tools/audio/build_music.py tools/audio/music_samples.py /app/tools/audio/
COPY tools/jelli-art/ /app/tools/jelli-art/

ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 JELLI_REPO=/work/jelligotchi JELLI_PORT=8765
USER studio
WORKDIR /work
VOLUME ["/work"]
EXPOSE 8765
HEALTHCHECK --interval=30s --timeout=5s --start-period=60s \
    CMD ["python", "/app/tools/jelli-art/healthcheck.py"]
ENTRYPOINT ["/app/tools/jelli-art/entrypoint.sh"]
